{
    "numeric_map":{
        "^\\s*un.?\\s*$": "1",
        "^\\s*dos\\s*$": "2",
        "^\\s*tres\\s*$": "3",
        "^\\s*cuatro\\s*$": "4",
        "^\\s*cinco\\s*$": "5",
        "^\\s*seis\\s*$": "6",
        "^\\s*siete\\s*$": "7",
        "^\\s*ocho\\s*$": "8",
        "^\\s*nueve\\s*$": "9",
        "^\\s*(\\d+) *y? medi[oa]": "$1.5",
        "^\\s*(\\d+) *y? cuarto": "$1.25",
        "^\\s*(\\d+) *(?:y )?1/4": "$1.25",
        "^\\s*(\\d+) *(?:y )?1/2": "$1.5",
        "^\\s*(\\d+) *(?:y )?3/4": "$1.75",
        "^nu[l1][l1]$": "",
        "O": "0",
        "o": "0",
        "Q": "0",
        "C": "0",
        "I": "1",
        "i": "1",
        "l": "1",
        "|": "1",
        "!": "1",
        "t": "1",
        "Z": "2",
        "z": "2",
        "A": "4",
        "S": "5",
        "ó": "6",
        "G": "6",
        "&": "6",
        "B": "8",
        "ö": "8",
        "g": "9"
    },
    "only_text_map":{
       "0": "O",
       "1": "l",
       "2": "Z",
       "3": "B",
       "4": "A",
       "5": "S",
       "6": "G",
       "7": "T",
       "8": "B",
       "9": "g"
    },
    "one_word_map":{
      "^\\W+": "",
      "\\W+$": "",
       " ": "_",
       "\t": "_",
       "{": "",
       "}": "",
       "[": "",
       "]": "",
       "#": "",
       "\\.[^$]": "",
       ",": "",
       ";": "",
       "+": "t",
       "/": "l",
       "?": "P",
       "¿": "g",
       "!": "I",
       "(": "C",
       ")": "D",
       "@": "a",
       "|": "l",
       "¡": "l"
    },
    "not_paragraph_map":{
      "^\\W+": "",
      "\\W+$": "",
       ";": ",",
       "{": "",
       "}": "",
       "[": "",
       "]": "",
       "#": "",
       "/": "l",
       "?": "P",
       "¿": "g",
       "!": "I",
       "@": "a",
       "|": "l",
       "¡": "l"
    },
    "not_parenthesis_map":{
       "(": "C",
       ")": "D"
    },
    "master_role": {
      "(\\w+\\.?) [Dd](?:(?:\\.)|(?:[ocea][nm]))$": "$1",
      "e([.apn])": "c$1",
      "epn": "cpn",
       "^\\s*\\?+\\s*$": ""
    },
    "travel_duration_unit": {
     "([DdHhMm])\\s+(\\.)$": "$1$2",
     "^\\s*\\?+\\s*$": "",
     "^.*default_value.*": "",
     "(?i)^l[.,]*$": "d.",
     "^1[.,]*$": "d."
   },
    "ship_tons_unit": {
      "^[^t].+": "t.",
      "d.*": "t."
    },
    "travel_duration_value": {
      "^\\s*\\?+\\s*$": ""
    },
    "travel_departure_port": {
      "^\\s*\\?+\\s*$": "",
      "^\\s*\\W\\s*": "",
      "^\\s*a ": ""
    },
    "ship_type": {
      "^\\s*\\?+\\s*$": ""
    },
    "ship_name":{
       "^\\s*\\?+\\s*$": ""
    },
    "ship_tons_capacity": {
       "^\\s*\\?+\\s*$": ""
    },
    "master_name": {
       "^\\s*\\?+\\s*$": ""
    }
}