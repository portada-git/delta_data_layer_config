{
  "$id": "https://portadaproject.eu/ship_entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ship_entry",
  "type": "object",
  "properties": {
    "entry_id": {
      "type": "string",
      "description": "Identificador único",
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "temp_key": {
      "type": "string",
      "description": "Identificador único provisional",
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "model_version": {
      "type": "string",
      "description": "Modelo de datos usado en una entrada.",
      "pattern": "^boat_fact-\\d{2}.\\d{2}.\\d{2}$",
      "nullable": false,
      "for_cleaning":["not_cleanable"],
      "fix_extraction_inconsistencies": {"id": "literal_value", "description":"Only one value is available", "type": "replace", "from": "LIT('boat_fact-00.00.01')"}
    },
    "publication_name": {
      "type": "string",
      "description": "Nombre identificador del periodico desde donde se ha extraído la entrada.",
      "minLength": 2,
      "maxLength": 2,
      "nullable": false,
      "for_cleaning":["not_cleanable"],
      "fix_extraction_inconsistencies": {
        "id": "fix_bad_name",
        "description": "Fix bad publication name (BD -> DB)",
        "type": "replace",
        "from": "LIT('DB')",
        "condition": {
          "column": "publication_name",
          "op": "==",
          "value": {
            "type": "l",
            "value": "BD"
          }
        }
      }
    },
    "publication_year": {
      "type": "string",
      "description": "Año en la que se publicó la noticia de la entrada.",
      "format": "integer",
      "minLength": 4,
      "maxLength": 4,
      "nullable": false,
      "for_cleaning":["not_cleanable"],
      "fix_extraction_inconsistencies": {
          "id": "fill_with_year_date",
          "description": "fill year with year date",
          "type": "replace_if_not_exist",
          "from": {
            "type": "expr",
            "value": "substring(publication_date, 1, 4)"
          },
          "condition": {
            "column": "publication_date",
            "op": "isNotNull"
          }
      }
    },
    "publication_date": {
      "type": "string",
      "description": "Fecha en la que se publicó la noticia de la entrada.",
      "format": "date",
      "nullable": false,
      "for_cleaning":["not_cleanable"]

    },
    "publication_edition": {
      "type": "string",
      "description": "Edición en la que se publicó la noticia de la entrada.",
      "minLength": 1,
      "maxLength": 1,
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "news_section":{
      "type": "string",
      "description": "Sección de la noticia.",
      "nullable": false,
      "for_cleaning":["not_cleanable"]
    },
    "parsed_text": {
      "type": "string",
      "description": "Es el fragmento texto correspondiente a la entrada extraída publicado en el periodico, fecha y edición indicada.",
      "nullable": false,
      "for_cleaning":["not_cleanable"],
      "fix_extraction_inconsistencies": {"type": "replace_if_not_exist", "from": "input_text"}
    },
    "travel_departure_date": {
      "type": "string",
      "description": "Fecha de salida del puerto en formato YYYY-MM-DD.",
      "format": "date",
      "nullable": true,
      "fill_with": {
        "id": "to_force_calculation",
        "description": "force calculation value",
        "type": "replace",
        "from": "LIT('')",
        "condition": "publication_name = 'DB'"
      },
      "calculable_if_null": {"operation": "decrement_data", "parameters":{"origin_date": "travel_arrival_date", "decrement": "travel_duration_value", "decrement_unit": "travel_duration_unit"}}
    },
    "travel_arrival_date": {
      "type": "string",
      "description": "Fecha de llegada al puerto en formato YYYY-MM-DD.",
      "format": "date",
      "nullable": true
    },
    "travel_duration_value": {
      "type": "number",
      "description": "Duración del viaje en días o horas.",
      "nullable": true,
      "for_cleaning":["accepted_idem"],
      "fix_extraction_inconsistencies": [
        {
          "id": "missing_id",
          "description": "fix with 'id' if is missing",
          "type": "replace",
          "from": "LIT('id.')",
          "condition": {
            "and": [
              "(travel_duration_value is null or cast(travel_duration_value as string) rlike '^(?:\\\\?+)|(?:.{2}default_value.{6})|(?:[^\\\\d]+)$')",
              "parsed_text rlike '(?i)^(?:(?:.{2,20})|(?:de .{2,40})) [eëéèê]n id[^i]'"
            ]
          }
        },
        {
          "id": "delete_bad_init",
          "description": "delete bad text at the start",
          "type": "replace",
          "from": {"type": "expr", "value": "regexp_extract(parsed_text, '(?i)^.{2,78}[eëéèê]n[.,;\\\\s]\\\\s*((?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?\\\\s+(?=[dhm]))|(?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?[\\\\d/óoö|!l&]\\\\s*(?=[dhm])))([dhm]\\\\.?).*$', 1)"},
          "condition": {
            "and": [
              "(travel_duration_value is null or cast(travel_duration_value as string) rlike '(?i)^(?:(?:\\\\?+)|(?:(?:[\\\\dóoöi|!l&]+ )|(?:[\\\\dóoö|!l&]+ ?)[dhm].{0,4})|(?:\\\\d*[ óoöi!VftiICálÍüKsSí.ì''o|dO%& ]+))$')",
              "parsed_text rlike '(?i)^.{2,78}[eëéèê]n[.,;\\\\s]\\\\s*((?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?\\\\s+(?=[dhm]))|(?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?[\\\\d/óoö|!l&]\\\\s*(?=[dhm])))([dhm]\\\\.?).*$'"
            ]
          }
        },
        {
          "id": "missig_or_bad",
          "description": "replace bad or missing duration",
          "type": "replace",
          "from": {"type": "expr", "value": "regexp_extract(parsed_text, '(?i)^.{2,78}\\\\s+([\\\\dóoöi|!l&]+)\\\\s*(?:(?:horas?)|(?:d[íi]as?)|(?:meses)|(?:mois)|(?:months?))\\\\W.*', 1)"},
          "condition": {
            "and": [
              "(travel_duration_value is null or cast(travel_duration_value as string) rlike '(?i)^(?:(?:\\\\?+)|(?:[\\\\dóoöi|!l&]+ ?[dhm].{0,4})|(?:\\\\d*[óoöi|!l&VftiICálÍüKsSí.ì''dO% ]+))$')",
              "parsed_text rlike '(?i)^.{2,78}\\\\s+([\\\\dóoöi|!l&]+)\\\\s*(?:(?:horas?)|(?:d[íi]as?)|(?:meses)|(?:mois)|(?:months?))\\\\W.*'"
            ]
          }
        }
      ],
      "calculable_if_null": {"operation":  "data_difference", "parameters":{"origin_date": "travel_departure_date", "final_date":  "travel_arrival_date"}}
    },
    "travel_duration_unit": {
      "type": "string",
      "description": "Unidad de medida de la duración del viaje.",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits", "one_word", "accepted_idem"],
      "fix_extraction_inconsistencies": [
        {
          "id": "missing_id",
          "description": "fix with 'id' if is missing",
          "type": "replace",
          "from": "LIT('id.')",
          "condition": {
            "and": [
              "(travel_duration_unit is null or cast(travel_duration_unit as string) rlike '(?i)^(?:(?!(?:id\\\\W?|idem) *$).+)?$')",
              "parsed_text rlike '(?i)^(?:(?:.{2,20})|(?:de .{2,40})) [eëéèê]n id[^i]'"
            ]
          }
        },
        {
          "id": "delete_bad_init",
          "description": "delete bad text at the start",
          "type": "replace",
          "from": {"type": "expr","value": "regexp_extract(parsed_text, '(?i)^.{2,78}\\\\s+(?:(?:[\\\\dóoöi|!l&]+(?: [\\\\d/óoöi|!l&]*)?)|(?:un)|(?:dos)|(?:tres))\\\\s*((?:horas?)|(?:d[íi]as?)|(?:meses)|(?:mois)|(?:months?))\\\\W.*', 1)"},
          "condition": {
            "and": [
              "(travel_duration_unit is null or cast(travel_duration_unit as string) rlike '(?i)^(?:(?!(?:ds?\\\\W?|hs?\\\\W?|ms?\\\\W?|dias?|horas?|mes(?:es)?|id\\\\W?|idem) *$).+)?$')",
              "parsed_text rlike '(?i)^.{2,78}\\\\s+(?:(?:[\\\\dóoöi|!l&]+(?: [\\\\dóoöi|!l&]/oöi|!l&]*)?)|(?:un)|(?:dos)|(?:tres))\\\\s*((?:horas?)|(?:d[íi]as?)|(?:meses)|(?:mois)|(?:months?))\\\\W.*'"
            ]
          }
        },
        {
          "id": "fix_month_unit",
          "description": "fix for month unit",
          "type": "replace",
          "from": "LIT('mes')",
          "condition": {
            "and": [
              "(travel_duration_unit is null or cast(travel_duration_unit as string) rlike '(?i)^(?:(?!mes\\\\W*$).+)?$')",
              "parsed_text rlike '(?i)^.{2,78}\\\\s+en un mes\\\\W.*'"
            ]
          }
        },
        {
          "id": "fix_unit",
          "description": "fix unit from parsed_text",
          "type": "replace",
          "from": {"type": "expr","value": "regexp_extract(parsed_text, '(?i)^.{2,78}[eëéèê]n[.,;\\\\s]\\\\s*((?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?\\\\s+(?=[dhm]))|(?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?[\\\\d/óoö|!l&]\\\\s*(?=[dhm])))([dhm]\\\\W?).*$', 2)"},
          "condition": {
            "and":[
              "(travel_duration_unit is null or cast(travel_duration_unit as string) rlike '(?i)^(?:(?!(?:ds?\\\\W?|hs?\\\\W?|ms?\\\\W?|dias?|horas?|mes(?:es)?|id\\\\W?|idem) *$).+)?$')",
              "parsed_text rlike '(?i)^.{2,78}[eëéèê]n[.,;\\\\s]\\\\s*((?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?\\\\s+(?=[dhm]))|(?:[\\\\dóoöi|!l&]+(?: (?:[yýỳv] )?[\\\\d/óoöi|!l&]*)?[\\\\d/óoö|!l&]\\\\s*(?=[dhm])))([dhm]\\\\W?).*$'"
            ]
          }
        },
        {
          "id": "missing_as_default",
          "description": "fix missing unit as default value",
          "type": "replace",
          "from": "LIT('d.')",
          "condition": { "and":[
            "publication_name = 'DB'",
            "(travel_duration_unit is null or travel_duration_unit rlike '^[,;.]+$')",
            "travel_duration_value rlike '^[\\\\dóoöi|!l&]+$'"
          ]}
        },
        {
          "id": "missing_id_as_default",
          "description": "fix missing unit as id value if travel_duration_value has id",
          "type": "replace_if_not_exist",
          "from": "LIT('id.')",
          "condition": { "and":[
            "publication_name = 'DB'",
            "travel_duration_value rlike '^id(?:..)?$'"
          ]}
        }
      ]
    },
    "travel_departure_port": {
      "type": "string",
      "description": "Puerto desde el cual salió el barco.",
      "nullable": true,
      "for_cleaning":["accepted_idem", "not_digits"],
      "fix_extraction_inconsistencies": [
         {
          "id": "missing_id",
          "description": "fix with 'id' if is missing",
          "type": "replace",
          "from": "LIT('id.')",
          "condition": {
            "and": [
              "publication_name = 'DB'",
              "travel_departure_port rlike '(?i)^(?:\\\\s*(?!id.{0,2}).+\\\\s*)?$'",
              "parsed_text rlike '(?i)^.{0,5}de id.*'"
            ]
          }
        },
        {
          "id": "fix_value_ademas",
          "description": "fix bad value with 'ademàs...' text",
          "type": "replace",
          "from": "LIT('')",
          "condition": {
            "and": [
              "publication_name = 'DB'",
              "travel_departure_port rlike '(?i)^\\\\W*adem[aáà]s(?:\\\\W*).*$'"
            ]
          }
        },
        {
          "id": "delete_end",
          "description": "delete extra end text",
          "type": "replace",
          "from": {"type": "expr", "value": "regexp_extract(travel_departure_port, '(?i)^\\\\W*(.*) en\\\\W*$', 1)"},
          "condition": {
            "and": [
              "publication_name = 'DB'",
              "travel_departure_port rlike '(?i)^\\W*(.*) en\\W*$'"
            ]
          }
        },
        {
          "id": "delete_init_1",
          "description": "delete extra init text",
          "type": "replace",
          "from": {"type": "expr", "value": "regexp_extract(travel_departure_port, '(?i)^\\\\W?(?!(?:id(?:[.,;])?\\\\b)|(?:idem\\\\b))[\\\\W\\\\d/óoöi|!l&]+(\\\\w?.*)$', 1)"},
          "condition": "travel_departure_port rlike '(?i)^\\\\W?(?!(?:id(?:[.,;])?\\\\b)|(?:idem\\\\b))[\\\\W\\\\d/óoöi|!l&]+(\\\\w?.*)$'"
        },
        {
          "id": "delete_init_2",
          "description": "delete extra init text",
          "type": "replace",
          "from": {"type": "expr", "value": "regexp_extract(travel_departure_port, '(?i)^\\\\W?(?!(?:id(?:[.,;])?\\\\b)|(?:idem\\\\b))[\\\\W\\\\d/óoöi|!l&]*\\\\s*(?:[db]el?(?:(?: +)|$))(\\\\w?.*)$', 1)"},
          "condition": {
            "and": [
              "travel_departure_port rlike '(?i)^\\\\W?(?!(?:id(?:[.,;])?\\\\b)|(?:idem\\\\b))[\\\\W\\\\d/óoöi|!l&]*\\\\s*(?:[db]el?(?:(?: +)|$))(\\\\w?.*)$'",
              "parsed_text rlike '(?i)^\\\\W?(?!(?:id(?:[.,;])?\\\\b)|(?:idem\\\\b))[\\\\W\\\\d/óoöi|!l&]*\\\\s*(?:[db]el?(?:(?: +)|$))(\\\\w?.*)$'"
            ]
          }
        },
        {
          "id": "delete_boat_type",
          "description": "delete boat type as port",
          "type": "replace",
          "from": "LIT('')",
          "condition":"travel_departure_port rlike '(?i)^\\\\W*(?:(?:bote)|(?:bergant[ií]n)|(?:buque)|(?:balandra)|(?:corbeta)|(?:crucero)|(?:fragata)|(?:goleta)|(?:lugre)|(?:guairo)|(?:m[íi]stico)|(?:jabeque)|(?:pailebot)|(?:la[úu]d)|(?:paquete)|(?:polacra)|(?:queche)|(?:tartana)|(?:transporte)|(?:vapor))(?:(?:\\\\W+)|$).*$'"
        },
        {
          "id": "fix_missing_value_1",
          "description": "Fix missing value from parsed_text",
          "type": "replace",
          "from": {
            "type": "expr",
            "value": "regexp_extract(parsed_text, '(?i)^\\\\W*de (?!arribad)((?!.{2,75} (?:(?:en)|(?:de)|(?:con)) .{2,75}[,.]? en).{2,75}?)[,.]? en (?:(?:[\\\\dóoöi|!l&])|(?:id)).*$', 1)"
          },
          "condition": {
            "and": [
              "publication_name = 'DB'",
              "(travel_departure_port is null or trim(cast(travel_departure_port as string)) = '' or startswith(regexp_extract(parsed_text, '(?i)^\\\\W*de (?!arribad)((?!.{2,75} (?:(?:en)|(?:de)|(?:con)) .{2,75}[,.]? en).{2,75}?)[,.]? en (?:(?:[\\\\dóoöi|!l&])|(?:id)).*$', 1), travel_departure_port))",
              "parsed_text rlike '(?i)^\\\\W*de (?!arribad)((?!.{2,75} (?:(?:en)|(?:de)|(?:con)) .{2,75}[,.]? en).{2,75}?)[,.]? en (?:(?:[\\\\dóoöi|!l&])|(?:id)).*$'"
            ]
          }
        },
        {
          "id": "fix_missing_value_2",
          "description": "Fix missing value from parsed_text",
          "type": "replace",
          "from": {
            "type": "expr",
            "value": "regexp_extract(parsed_text, '(?i)^\\\\W*de (?!arribad)((?!.{2,30} (?:(?:en)|(?:de)|(?:con)) .{2,30}[,.]? en).{2,30}?)[,.]? (?:(?:[\\\\dóoöi|!l&])|(?:id)).*$', 1)"
          },
          "condition":{
            "and":[
              "publication_name = 'DB'",
              "(travel_departure_port is null or trim(cast(travel_departure_port as string)) = '' or startswith(regexp_extract(parsed_text, '(?i)^\\\\W*de (?!arribad)((?!.{2,30} (?:(?:en)|(?:de)|(?:con)) .{2,30}[,.]? en).{2,30}?)[,.]? (?:(?:[\\\\dóoöi|!l&])|(?:id)).*$', 1), travel_departure_port))",
              "parsed_text rlike '(?i)^\\\\W*de (?!arribad)((?!.{2,30} (?:(?:en)|(?:de)|(?:con)) .{2,30}[,.]? en).{2,30}?)[,.]? (?:(?:[\\\\dóoöi|!l&])|(?:id)).*$'"
            ]
          }
        },
        {
          "id": "delete_port_of_call_1",
          "description": "Delete all port of call from departure port",
          "type": "replace",
          "lazy": true,
          "from": {
            "type": "expr",
            "value": "regexp_extract(travel_departure_port, '(?i)^(?:(?!escala)(.*?)\\\\W)?(?:(?:[yv] ?)| en | a )?(escalas?)?(?: en)?$', 1)"
          },
          "condition": "travel_departure_port rlike '(?i)^(?:(?!escala)(.*?)\\\\W)?(?:(?:[yv] ?)| en | a )?(escalas?)?(?: en)?$'"
        },
        {
          "id": "delete_port_of_call_2",
          "description": "Delete all port of call from departure port",
          "type": "replace",
          "lazy": true,
          "from": {
            "type": "expr",
            "value": "trim(element_at(split(regexp_replace(travel_departure_port, '(?i)\\\\s+[yýỳveéè;]\\\\s+', ','), ','), 1))"
          },
          "condition": "travel_departure_port rlike '(?iuU)^(?:[\\\\w¡!()\\\\-. ''’:\\\\ufffd16]+, ?)*[\\\\w¡!()\\\\-. ''’:\\\\ufffd16]+?(?:(?:(?:(?: +[yýỳv ])|,) +)|(?:[eéè] i))[\\\\w¡!()\\\\-. ''’:\\\\ufffd16]+$'"
        }
      ]
    },
    "travel_port_of_call_list": {
      "type": "array",
      "description": "Lista de puertos donde el barco hizo escala.",
      "items": {
        "type": "object",
        "properties": {
          "port_of_call_place": {
            "type": "string",
            "description": "Puerto donde hizo la escala.",
            "nullable": false,
            "for_cleaning": ["accepted_idem", "not_digits"]
          },
          "port_of_call_arrival_date": {
            "type": "string",
            "format": "date",
            "description": "Fecha de llegada al puerto de escala.",
            "nullable": true
          },
          "port_of_call_departure_date": {
            "type": "string",
            "format": "date",
            "description": "Fecha de llegada al puerto de escala.",
            "nullable": true
          }
        },
        "required": [
          "port_of_call_place"
        ],
        "additionalProperties": false
      },
      "normalize": {
        "type": "foreach_item",
        "options": [
          {
            "try_cast_to": {
              "type": "object",
              "properties":{
                "port_of_call_place": {
                  "type": "string"
                },
                "port_of_call_arrival_date": {
                  "type": "string"
                },
                "port_of_call_departure_date": {
                  "type": "string"
                }
              }
            },
            "equivalence": {
              "type": "struct",
              "new_value": {
                "port_of_call_place": {
                  "type": "column",
                  "value": "old_value.port_of_call_place"
                },
                "port_of_call_arrival_date": {
                  "type": "column",
                  "value": "old_value.port_of_call_arrival_date"
                },
                "port_of_call_departure_date": {
                  "type": "column",
                  "value": "old_value.port_of_call_departure_date"
                }
              }
            }
          },{
            "try_cast_to": {
              "type": "string"
            },
            "equivalence": {
              "type": "struct",
              "new_value": {
                "port_of_call_place": {
                  "type": "column",
                  "value": "old_value"
                },
                "port_of_call_arrival_date": {
                  "type": "literal",
                  "value": null
                },
                "port_of_call_departure_date": {
                  "type": "literal",
                  "value": null
                }
              }
            }
          }
        ],
        "otherwise":{
            "equivalence": {
              "type": "struct",
               "new_value": {
                "port_of_call_place": {
                  "type": "literal",
                  "value": null
                },
                "port_of_call_arrival_date": {
                  "type": "literal",
                  "value": null
                },
                "port_of_call_departure_date": {
                  "type": "literal",
                  "value": null
                }
              }
            }
        }
      },
      "fix_extraction_inconsistencies": [
        {
          "id": "fix_from_departure_port_1",
          "description": "Fill all port of call from departure port",
          "type": "add_array_from_list",
          "from": {
            "type": "expr",
            "value": "filter(slice(transform(split(regexp_replace(travel_departure_port, '(?i)\\\\s+[yýỳveéè;]\\\\s+', ','), ','), x -> trim(x)), 2, 50), x -> x is not null and length(x) > 0)"
          },
          "to": ["port_of_call_place"],
          "condition": {
            "and": [
              "travel_departure_port rlike '(?iuU)^(?:[\\\\w¡!(). ]+, ?)*[\\\\w¡!(). ]+?(?:(?:(?:(?: +[yýỳv ])|,) +)|(?:eéè i))[\\\\w¡!(). ]+$'",
              "(travel_port_of_call_list is null or size(travel_port_of_call_list) = 0)"
            ]
          }
        },
        {
          "id": "fix_from_departure_port_1",
          "description": "Fill all port of call from departure port",
          "type": "add_array_item",
          "from": ["LIT('escalas')", null, null],
          "to": [
            "port_of_call_place",
            "port_of_call_arrival_date",
            "port_of_call_departure_date"
          ],
          "condition": {
            "and": [
              "travel_departure_port rlike '(?i)^(?:(?!escala)(.*?)\\\\W)?(?:(?:[yv] ?)| en | a )?(escalas?)?(?: en)?$'",
              "(travel_port_of_call_list is null or not exists(travel_port_of_call_list, x -> lower(trim(cast(x.port_of_call_place as string))) rlike '(?i)^escalas?$'))"
            ]
          }
        },
        {
          "id": "delete_duplicates",
          "description": "Delete duplicates in port of calls",
          "type": "replace",
          "from": {
            "type": "expr",
            "value": "filter(travel_port_of_call_list, x -> not (lower(trim(cast(x.port_of_call_place as string))) = 'en' and x.port_of_call_arrival_date is null and x.port_of_call_departure_date is null))"
          },
          "condition": "travel_port_of_call_list is not null and exists(travel_port_of_call_list, x -> lower(trim(cast(x.port_of_call_place as string))) = 'en' and x.port_of_call_arrival_date is null and x.port_of_call_departure_date is null)"
        }
      ]
    },
    "travel_arrival_port": {
      "type": "string",
      "description": "Puerto al que llegó el barco.",
      "nullable": true,
      "for_cleaning":["accepted_idem", "not_digits"]
    },
    "ship_type": {
      "type": "string",
      "description": "Tipo de embarcación.",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits", "not_parenthesis"],
      "fix_extraction_inconsistencies": [
        {
          "id": "delete_bad_value_1",
          "description": "elimina el contenido con una única letra que no sea inicial de un tipo de barco",
          "type": "replace",
          "from": "LIT('')",
          "condition": {
              "and":[
                "publication_name = 'DB'",
                "ship_type rlike '(?iuU)^\\\\W*(?:[yýỳeéè][ ,.;]|[^bcfglmjpqtv]) *$'"
              ]
          }
        },
        {
          "id": "delete_bad_value_2",
          "description": "elimina el contenido con valores erroneos",
          "type": "replace",
          "from": "LIT('')",
          "condition": {
              "and":[
                "publication_name = 'DB'",
                "ship_type rlike '(?iuU)^\\\\W*(?:antes|d[iíìï]as?)\\\\W*$'"
              ]
          }
        },
        {
          "id": "delete_bad_init_1",
          "description": "elimina el contenido inicial incorrecto",
          "type": "replace",
          "from": {"type": "expr", "value": "regexp_extract(ship_type, '(?iuU)^\\\\W*(?:(?:\\\\w\\\\W+(?:\\\\w\\\\W+)?(?=bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor))|[dyýỳÿeéèë]\\\\W+|(?:[íìi]d(?:em|[.,]{0,3})?\\\\W(?=bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor))|(?:id\\\\W+(?:en\\\\W+(?:(?:id)|(?:\\\\d{1,5}\\\\W+(?:[dhm][.,]{0,3}|d[iíì]as?|horas?|mes(?:es)?)))\\\\W+))?)(\\\\w{4,}.*)$', 1)"},
          "condition": {
              "and":[
                "publication_name = 'DB'",
                "ship_type rlike '(?iuU)^\\\\W*(?:(?:\\\\w\\\\W+(?:\\\\w\\\\W+)?(?=bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor))|[dyýỳÿeéèë]\\\\W+|(?:[íìi]d(?:em|[.,]{0,3})?\\\\W(?=bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor))|(?:id\\\\W+(?:en\\\\W+(?:(?:id)|(?:\\\\d{1,5}\\\\W+(?:[dhm][.,]{0,3}|d[iíì]as?|horas?|mes(?:es)?)))\\\\W+))?)(\\\\w{4,}.*)$'"
              ]
          }
        },
        {
          "id": "delete_bad_init_2",
          "description": "elimina el contenido inicial incorrecto",
          "type": "replace",
          "from": {"type": "expr", "value": "regexp_extract(ship_type, '(?iuU)^ *(?:d[íìïi]as?\\\\.?,? |[ndb]s?\\\\.?[, ]|en |conducido por el |y escalas |del [uúù]ltimo punto |entro el ) *(.+)$', 1)"},
          "condition": {
              "and":[
                "publication_name = 'DB'",
                "ship_type rlike '(?iuU)^ *(?:mes(?:es)?[.,]{0,2} |d[íìïi]as?[.,]{0,2} |[ndb]s?[.,]{0,2} |en |conducido por el |(?:y )?escalas |del [uúù]ltimo punto |entro el |(?:de)? la mar (?:el|un|l|una)? ) *(.+)$'"
              ]
          }
        },
        {
          "id": "ship_type_from_parsed_text",
          "description": "Si no tiene valor extrau una palabra clave del parsed_text, pues los tipos de barco no se repiten en la notícia ",
          "type": "replace",
          "from": {
            "type": "expr",
            "value": "regexp_extract(parsed_text, '(?i)^.*?\\\\b((?:bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor)(?:[- ](?:bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor))?)\\\\b.*$', 1)"
          },
          "condition": {
              "and":[
                "publication_name = 'DB'",
                "(ship_type is null or trim(cast(ship_type as string)) = '')",
                "parsed_text rlike '(?i)^.*?\\\\b((?:bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor)(?:[- ](?:bote|bergant[ií]n|buque|balandra|corbeta|crucero|fragata|goleta|lugre|guairo|m[íi]stico|jabeque|pailebot|la[úu]d|paquete|polacra|queche|tartana|transporte|vapor))?)\\\\b.*$'"
              ]
          }
        },
        {
          "id": "delete_flag_part",
          "description": "Elimina la bandera del contenido si el campo ship_flag contiene extrangeras",
          "type": "replace",
          "lazy": true,
          "from": {
            "type": "expr",
            "value": "regexp_extract(ship_type, '(?iuU)^\\\\W*(.*(?!-))\\\\W(\\\\w+)$', 1)"
          },
          "condition": {
            "and": [
              "publication_name = 'DB'",
              "ship_type rlike '(?iuU)^\\\\W*(.*(?!-))\\\\W(\\\\w+)$'",
              {
                "or": [
                  "ship_flag rlike '(?iuU)^.*?\\\\W*e[xs]tran[gj].*\\\\W*?$'",
                  "trim(cast(ship_flag as string)) = regexp_extract(ship_type, '(?iuU)^\\\\W*(.*(?!-))\\\\W(\\\\w+)$', 2)"
                ]
              }
            ]
          }
        }
      ]
    },
    "ship_name": {
      "type": "string",
      "description": "Nombre del barco.",
      "nullable": true,
      "for_cleaning": "not_parenthesis"
    },
    "ship_tons_capacity": {
      "type": "integer",
      "description": "Capacidad de carga del buque en toneladas. Debido a los posibles errores de transcripción del OCR, este dato se expresará como una cadena de caracteres. Si en la transcrición indicara, por ejemplo que el barco tiene una capacidad de 'B7 t.', en este campo deberá trasladarse el valor B7. Si se omitiera este valor dejaras este valor a null",
      "nullable": true
    },
    "ship_tons_unit": {
      "type": "string",
      "description": "Especifica las unidades en las que está expresado las dimensiones del buque. Normalmente toneladas, simbolizadas por la abreviación 't.'",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits", "one_word"],
      "fill_with": {"type": "replace_if_not_exist", "from": "ship_tons_units"}
    },
    "ship_flag": {
      "type": "string",
      "description": "País o nacionalidad bajo cuya bandera navega el barco. Ejemplos: 'español', 'americano', 'oriental'",
      "nullable": true,
      "for_cleaning":["accepted_idem",  "not_digits", "not_parenthesis"],
      "fix_extraction_inconsistencies": [
        {
          "id": "extract_flag_from_ship_type",
          "description": "Extrae la bandera del contenido si el campo ship_type si ship_falg contiene extrangeras",
          "type": "replace",
          "from": {
            "type": "expr",
            "value": "regexp_extract(ship_type, '(?iuU)^\\\\W*(.*(?!-))\\\\W(\\\\w+)$', 2)"
          },
          "condition": {
            "and": [
              "publication_name = 'DB'",
              "ship_type rlike '(?iuU)^\\\\W*(.*(?!-))\\\\W(\\\\w+)$'",
              "ship_flag rlike '(?iuU)^.*?\\\\W*e[xs]tran[gj].*\\\\W*?$'"
            ]
          }
        }
      ]
    },
    "master_role": {
      "type": "string",
      "description": "Cargo del responsable a bordo. Puede ser 'capitan' abreviado con c. o cap., 'piloto'abreviado con pil. o 'patrón' abreviado con p. o pat.",
      "nullable": true,
      "for_cleaning":["accepted_abbreviations", "not_digits", "one_word", "accepted_idem"]
    },
    "master_name": {
      "type": "string",
      "description": "Nombre del responsable a bordo.",
      "nullable": true,
      "for_cleaning": ["not_digits","not_parenthesis"]
    },
    "broker_name": {
      "type": "string",
      "description": "Nombre del agente marítimo.",
      "nullable": true,
      "for_cleaning":["not_digits", "not_parenthesis"]
    },
