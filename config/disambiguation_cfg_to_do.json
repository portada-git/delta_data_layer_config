{
  "version": 3,
  "normalize": false,
  "consensus": {
    "min_votes": "debe ser una valor dinámico: n/2 + 1",
    "require_algorithm": false
  },
  "labeled_data_path": "revision.ship_entries",
  "general_config_algorithms": {
      "levenshtein": {
        "class": "LevenshteinAlgorithm",
        "thresholds": [0.95, 0.80],
        "params": {}
      },
      "jaro_winkler": {
        "class": "JaroWinklerAlgorithm",
        "thresholds": [0.90],
        "params": {}
      },
      "ngram_2": {
        "class": "NgramAlgorithm",
        "thresholds": [0.75],
        "params": {"n":2}
      },
      "ngram_3": {
        "class": "NgramAlgorithm",
        "thresholds":  [0.75],
        "params": {"n": 3}
      },
      "ngram_4": {
        "class": "NgramAlgorithm",
        "thresholds":  [0.75],
        "params": {"n": 4}
      },
      "phonetic_dm": {
        "class": "PhoneticDmAlgorithm",
        "thresholds": [0.9, 0.78],
        "params": {}
      },
      "soundex": {
        "class": "SoundexALgorithm",
        "thresholds": [0.9],
        "params": {}
      },
      "fasttext": {
        "class": "FastTextALgorithm",
        "thresholds": [0.8,0.6],
        "params": { "model_path": "models/fasttext/cc.es.300.bin" }
      },
      "byt5": {
        "class": "ByT5Algorithm",
        "thresholds": [0.9,0.7],
        "params": { "model_name": "agusnieto77/byt5-portada-contrastivo"}
      },
      "text2vec": {
        "class": "SentenceModelAlgorithm",
        "thresholds": [0.95, 0.7],
        "params": { "model_name": "shibing624/text2vec-base-multilingual"}
      },
      "sentence_transformer_LABSE": {
        "class": "SentenceTransformerAlgorithm",
        "thresholds": [0.95,0.7],
        "params": {
          "model": "sentence-transformers/LaBSE"
        }
      },
      "sentence_transformer_mpnet": {
        "class": "SentenceTransformerAlgorithm",
        "thresholds": [0.95, 0.7],
        "params": {"model_name": "paraphrase-multilingual-mpnet-base-v2"}
      }
   },
